# 複製此檔案為 .env，並依本機環境修改（.env 已加入 .gitignore，不會 commit）

# ===========================
# PostgreSQL
# ===========================
POSTGRES_USER=livebeat
POSTGRES_PASSWORD=livebeat_dev

# ===========================
# Redis
# ===========================
REDIS_PASSWORD=livebeat_dev

# ===========================
# RabbitMQ
# ===========================
RABBITMQ_USER=livebeat
RABBITMQ_PASSWORD=livebeat_dev

# ===========================
# MinIO（本機 S3）
# ===========================
MINIO_ROOT_USER=livebeat
MINIO_ROOT_PASSWORD=livebeat_dev_secret

# ===========================
# JWT（必填，無預設值）
# ===========================
# 應用程式啟動時會驗證此密鑰：必須非空且長度 >= 32 bytes（HS256 / 256-bit），否則拒絕啟動。
# 請以高熵亂數產生並改為自己的值，切勿沿用此假值：
#   openssl rand -base64 48
# 正式環境應改由 Secret Manager（規劃導入 HashiCorp Vault）注入，勿寫進 .env。
JWT_SECRET=REPLACE_ME_with_a_random_32byte_or_longer_secret_value

# Cookie 是否標記 Secure（正式環境走 HTTPS 時設為 true）
COOKIE_SECURE=false
